# Local development secrets for `docker compose up`.
#
# Copy this file to `.env` (same directory as docker-compose.yml) before
# starting the stack:
#
#     cp .env.example .env
#
# Docker Compose auto-loads `.env`, so no extra flags are needed after copying.
# `.env` is gitignored — NEVER commit real secrets. Replace the placeholder
# values below for anything beyond local development.
#
# The cluster refuses to start when CLUSTER_SECRET is empty (security
# hardening), so this file must be present for local runs.

# Shared secret authenticating the server <-> cluster control channel.
CLUSTER_SECRET=dev-local-cluster-secret-change-me

# Session-signing secret for the backend. Must be at least 32 characters.
BACKEND_SECRET=dev-local-backend-session-secret-change-me
